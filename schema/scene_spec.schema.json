{
  "$defs": {
    "ActionSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Registered action: walk, wave, talk, ...",
          "title": "Name",
          "type": "string"
        },
        "t0": {
          "minimum": 0,
          "title": "T0",
          "type": "number"
        },
        "t1": {
          "minimum": 0,
          "title": "T1",
          "type": "number"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "name",
        "t0",
        "t1"
      ],
      "title": "ActionSpec",
      "type": "object"
    },
    "AudioSpec": {
      "additionalProperties": false,
      "properties": {
        "music": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path to a music file, 'procedural' or 'procedural:<mood>' for the built-in generated bed, or null for no music",
          "title": "Music"
        },
        "voiceover": {
          "default": "none",
          "enum": [
            "tts",
            "file",
            "none"
          ],
          "title": "Voiceover",
          "type": "string"
        },
        "ducking": {
          "default": true,
          "description": "lower the music under voice",
          "title": "Ducking",
          "type": "boolean"
        },
        "voiceover_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Audio file used when voiceover='file'",
          "title": "Voiceover File"
        },
        "tts_voice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default TTS voice id/model",
          "title": "Tts Voice"
        },
        "music_gain_db": {
          "default": -16.0,
          "maximum": 12,
          "minimum": -60,
          "title": "Music Gain Db",
          "type": "number"
        },
        "voice_gain_db": {
          "default": 0.0,
          "maximum": 12,
          "minimum": -60,
          "title": "Voice Gain Db",
          "type": "number"
        },
        "sfx_gain_db": {
          "default": -8.0,
          "maximum": 12,
          "minimum": -60,
          "title": "Sfx Gain Db",
          "type": "number"
        },
        "auto_sfx": {
          "default": false,
          "description": "add footsteps/landings emitted by actions",
          "title": "Auto Sfx",
          "type": "boolean"
        }
      },
      "title": "AudioSpec",
      "type": "object"
    },
    "BackgroundSpec": {
      "additionalProperties": false,
      "properties": {
        "template": {
          "description": "Background template, e.g. room | street | forest | abstract",
          "title": "Template",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "description": "Template parameters (time_of_day, mood, density, ...)",
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "template"
      ],
      "title": "BackgroundSpec",
      "type": "object"
    },
    "CameraMoveSpec": {
      "additionalProperties": false,
      "description": "One camera move. `from`/`to` meaning depends on `type`:\npan [x,y] screen-fraction offset | zoom scale (1=none) | dolly 0..1 push-in |\nshake intensity 0..1 | rack_focus a depth ('background'|'midground'|'foreground'|0..1).",
      "properties": {
        "type": {
          "description": "pan | zoom | shake | dolly | rack_focus ...",
          "title": "Type",
          "type": "string"
        },
        "from": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From"
        },
        "to": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To"
        },
        "t0": {
          "minimum": 0,
          "title": "T0",
          "type": "number"
        },
        "t1": {
          "minimum": 0,
          "title": "T1",
          "type": "number"
        },
        "ease": {
          "default": "ease_in_out",
          "description": "easing curve name",
          "title": "Ease",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "type",
        "t0",
        "t1"
      ],
      "title": "CameraMoveSpec",
      "type": "object"
    },
    "CameraSpec": {
      "additionalProperties": false,
      "properties": {
        "moves": {
          "items": {
            "$ref": "#/$defs/CameraMoveSpec"
          },
          "title": "Moves",
          "type": "array"
        }
      },
      "title": "CameraSpec",
      "type": "object"
    },
    "CaptionSpec": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "t0": {
          "minimum": 0,
          "title": "T0",
          "type": "number"
        },
        "t1": {
          "minimum": 0,
          "title": "T1",
          "type": "number"
        },
        "style": {
          "default": "subtitle",
          "description": "subtitle | title | shout",
          "title": "Style",
          "type": "string"
        },
        "speaker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Character id who says it (drives lip-sync)",
          "title": "Speaker"
        },
        "speak": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Read aloud by TTS. Default: true for subtitles, false otherwise",
          "title": "Speak"
        },
        "anchor": {
          "default": "auto",
          "enum": [
            "auto",
            "top",
            "center",
            "bottom"
          ],
          "title": "Anchor",
          "type": "string"
        }
      },
      "required": [
        "text",
        "t0",
        "t1"
      ],
      "title": "CaptionSpec",
      "type": "object"
    },
    "CharacterSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Unique id referenced by scene layers",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "archetype": {
          "description": "Body/face template, e.g. everyman | kid | elder | hero | robot",
          "title": "Archetype",
          "type": "string"
        },
        "palette": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Colour overrides by role (skin, hair, shirt, shirt2, pants, shoes, accent), hex",
          "title": "Palette",
          "type": "object"
        },
        "props": {
          "description": "Props this character owns/wears",
          "items": {
            "type": "string"
          },
          "title": "Props",
          "type": "array"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Display name (used for TTS voice mapping)",
          "title": "Name"
        },
        "voice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "TTS voice override for this character",
          "title": "Voice"
        }
      },
      "required": [
        "id",
        "archetype"
      ],
      "title": "CharacterSpec",
      "type": "object"
    },
    "FxSpec": {
      "additionalProperties": false,
      "description": "Optional per-spec overrides of the style's post-processing. ``null`` keeps the style default;\n``0`` switches an effect off.  Values are strengths, not absolute units.",
      "properties": {
        "grain": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "film grain strength",
          "title": "Grain"
        },
        "vignette": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "corner darkening strength",
          "title": "Vignette"
        },
        "bloom": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "glow around bright areas",
          "title": "Bloom"
        },
        "chromatic_aberration": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "subtle RGB fringing towards the frame edges",
          "title": "Chromatic Aberration"
        },
        "saturation": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1 = style default",
          "title": "Saturation"
        },
        "contrast": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1 = style default",
          "title": "Contrast"
        },
        "warmth": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "-1 cool .. +1 warm colour grade",
          "title": "Warmth"
        },
        "letterbox": {
          "anyOf": [
            {
              "maximum": 0.3,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "fraction of frame height blanked top and bottom",
          "title": "Letterbox"
        }
      },
      "title": "FxSpec",
      "type": "object"
    },
    "LayerSpec": {
      "additionalProperties": false,
      "properties": {
        "character": {
          "description": "Character id",
          "title": "Character",
          "type": "string"
        },
        "position": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "string"
            }
          ],
          "description": "[x,y] of the feet in screen fractions, or a named slot of the background (left | center | right | far_left | far_right | ...)",
          "title": "Position"
        },
        "scale": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 4,
          "title": "Scale",
          "type": "number"
        },
        "depth": {
          "default": "mid",
          "enum": [
            "background",
            "mid",
            "foreground"
          ],
          "title": "Depth",
          "type": "string"
        },
        "facing": {
          "default": "auto",
          "enum": [
            "auto",
            "left",
            "right"
          ],
          "title": "Facing",
          "type": "string"
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/ActionSpec"
          },
          "title": "Actions",
          "type": "array"
        }
      },
      "required": [
        "character"
      ],
      "title": "LayerSpec",
      "type": "object"
    },
    "LibraryGapSpec": {
      "additionalProperties": false,
      "description": "Something the script asks for that the asset library does not have, and what the spec shows instead.\n\nReel Studio lists these under \"not in the library\"; once the asset is added, ``scenes`` / ``character`` /\n``stand_in`` say what to swap.  The renderer ignores them.",
      "properties": {
        "kind": {
          "enum": [
            "character",
            "object",
            "place"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "description": "what the script calls it: dragon, castle, rickshaw",
          "maxLength": 60,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "scenes": {
          "description": "ids of the scenes that want it",
          "items": {
            "type": "string"
          },
          "title": "Scenes",
          "type": "array"
        },
        "character": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "characters only: the id of the character standing in for it",
          "title": "Character"
        },
        "stand_in": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the library name shown instead, or null when it was left out",
          "title": "Stand In"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "LibraryGapSpec",
      "type": "object"
    },
    "MetaSpec": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "description": "Working title of the reel",
          "title": "Title",
          "type": "string"
        },
        "style": {
          "description": "Style pack name, e.g. paper_cutout | stickman | flat_vector",
          "title": "Style",
          "type": "string"
        },
        "fps": {
          "default": 30,
          "maximum": 60,
          "minimum": 12,
          "title": "Fps",
          "type": "integer"
        },
        "resolution": {
          "description": "[width, height] in pixels",
          "items": {
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Resolution",
          "type": "array"
        },
        "seed": {
          "default": 0,
          "description": "Seeds every random choice: same spec + seed => same video",
          "title": "Seed",
          "type": "integer"
        },
        "target_duration_sec": {
          "default": 50.0,
          "description": "Intended length, 45-60 seconds",
          "maximum": 60.0,
          "minimum": 45.0,
          "title": "Target Duration Sec",
          "type": "number"
        },
        "aspect": {
          "const": "9:16",
          "default": "9:16",
          "title": "Aspect",
          "type": "string"
        },
        "fx": {
          "anyOf": [
            {
              "$ref": "#/$defs/FxSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "override the style's post-FX strengths"
        },
        "safe_area": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeArea"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "caption safe-area margins"
        },
        "library_gaps": {
          "description": "characters, places and objects the script needs that the asset library lacks",
          "items": {
            "$ref": "#/$defs/LibraryGapSpec"
          },
          "title": "Library Gaps",
          "type": "array"
        }
      },
      "required": [
        "title",
        "style"
      ],
      "title": "MetaSpec",
      "type": "object"
    },
    "ObjectMotionSpec": {
      "additionalProperties": false,
      "description": "One motion of an object: ``move`` | ``hop`` | ``float`` | ``spin`` | ``pulse`` | ``fade`` | ``grow`` | ``shake``.\n\n``to`` is where a move goes ([x, y] or a slot) and the final value of a fade or grow; ``from`` is where a fade or\ngrow starts; ``amount`` and ``count`` tune hop, float, spin, pulse and shake (each has a default).",
      "properties": {
        "type": {
          "description": "move | hop | float | spin | pulse | fade | grow | shake",
          "title": "Type",
          "type": "string"
        },
        "t0": {
          "minimum": 0,
          "title": "T0",
          "type": "number"
        },
        "t1": {
          "minimum": 0,
          "title": "T1",
          "type": "number"
        },
        "from": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "fade and grow: the start value",
          "title": "From"
        },
        "to": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "move: [x, y] or a slot; fade and grow: the end value",
          "title": "To"
        },
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "size of the effect (see the motion)",
          "title": "Amount"
        },
        "count": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "hop and pulse: how many times",
          "title": "Count"
        },
        "ease": {
          "default": "ease_in_out",
          "description": "easing curve name",
          "title": "Ease",
          "type": "string"
        }
      },
      "required": [
        "type",
        "t0",
        "t1"
      ],
      "title": "ObjectMotionSpec",
      "type": "object"
    },
    "ObjectSpec": {
      "additionalProperties": false,
      "description": "A thing from the asset library placed in a scene (a car, a tree, a cake).",
      "properties": {
        "asset": {
          "description": "Library object, e.g. car | tree | cake",
          "title": "Asset",
          "type": "string"
        },
        "position": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "string"
            }
          ],
          "description": "[x,y] of the point it stands on, in screen fractions, or a slot of the background",
          "title": "Position"
        },
        "scale": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 6,
          "title": "Scale",
          "type": "number"
        },
        "depth": {
          "default": "mid",
          "enum": [
            "background",
            "mid",
            "foreground"
          ],
          "title": "Depth",
          "type": "string"
        },
        "layer": {
          "default": "behind",
          "description": "at depth 'mid': drawn behind the characters, or in front of them",
          "enum": [
            "behind",
            "front"
          ],
          "title": "Layer",
          "type": "string"
        },
        "facing": {
          "default": "auto",
          "enum": [
            "auto",
            "left",
            "right"
          ],
          "title": "Facing",
          "type": "string"
        },
        "rotation": {
          "default": 0.0,
          "description": "degrees, clockwise",
          "maximum": 360,
          "minimum": -360,
          "title": "Rotation",
          "type": "number"
        },
        "alpha": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Alpha",
          "type": "number"
        },
        "t0": {
          "default": 0.0,
          "description": "visible from this time",
          "minimum": 0,
          "title": "T0",
          "type": "number"
        },
        "t1": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "visible until this time (default: the end of the scene)",
          "title": "T1"
        },
        "motions": {
          "items": {
            "$ref": "#/$defs/ObjectMotionSpec"
          },
          "title": "Motions",
          "type": "array"
        },
        "palette": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "colour overrides for the recolourable parts, hex",
          "title": "Palette",
          "type": "object"
        }
      },
      "required": [
        "asset"
      ],
      "title": "ObjectSpec",
      "type": "object"
    },
    "SafeArea": {
      "additionalProperties": false,
      "description": "Fractions of the frame kept clear of captions (platform UI overlays on reels/shorts).",
      "properties": {
        "top": {
          "default": 0.1,
          "maximum": 0.4,
          "minimum": 0,
          "title": "Top",
          "type": "number"
        },
        "bottom": {
          "default": 0.2,
          "maximum": 0.4,
          "minimum": 0,
          "title": "Bottom",
          "type": "number"
        },
        "left": {
          "default": 0.07,
          "maximum": 0.4,
          "minimum": 0,
          "title": "Left",
          "type": "number"
        },
        "right": {
          "default": 0.07,
          "maximum": 0.4,
          "minimum": 0,
          "title": "Right",
          "type": "number"
        }
      },
      "title": "SafeArea",
      "type": "object"
    },
    "SceneSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "duration_sec": {
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Duration Sec",
          "type": "number"
        },
        "background": {
          "$ref": "#/$defs/BackgroundSpec"
        },
        "camera": {
          "$ref": "#/$defs/CameraSpec"
        },
        "layers": {
          "items": {
            "$ref": "#/$defs/LayerSpec"
          },
          "title": "Layers",
          "type": "array"
        },
        "objects": {
          "description": "things from the asset library placed in the scene",
          "items": {
            "$ref": "#/$defs/ObjectSpec"
          },
          "title": "Objects",
          "type": "array"
        },
        "captions": {
          "items": {
            "$ref": "#/$defs/CaptionSpec"
          },
          "title": "Captions",
          "type": "array"
        },
        "sfx": {
          "items": {
            "$ref": "#/$defs/SfxSpec"
          },
          "title": "Sfx",
          "type": "array"
        },
        "transition_out": {
          "$ref": "#/$defs/TransitionSpec"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Free-form director's note; ignored by the renderer",
          "title": "Notes"
        }
      },
      "required": [
        "id",
        "duration_sec",
        "background"
      ],
      "title": "SceneSpec",
      "type": "object"
    },
    "SfxSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "t": {
          "minimum": 0,
          "title": "T",
          "type": "number"
        },
        "volume": {
          "default": 1.0,
          "maximum": 2,
          "minimum": 0,
          "title": "Volume",
          "type": "number"
        }
      },
      "required": [
        "name",
        "t"
      ],
      "title": "SfxSpec",
      "type": "object"
    },
    "TransitionSpec": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "default": "cut",
          "description": "cut | crossfade | wipe | page_flip",
          "title": "Type",
          "type": "string"
        },
        "duration": {
          "default": 0.0,
          "description": "seconds; overlaps the next scene",
          "maximum": 3.0,
          "minimum": 0,
          "title": "Duration",
          "type": "number"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "title": "TransitionSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "optional JSON Schema pointer for editor validation; ignored",
      "title": "$Schema"
    },
    "version": {
      "default": "1.0",
      "title": "Version",
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/MetaSpec"
    },
    "characters": {
      "items": {
        "$ref": "#/$defs/CharacterSpec"
      },
      "title": "Characters",
      "type": "array"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/SceneSpec"
      },
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    },
    "audio": {
      "$ref": "#/$defs/AudioSpec"
    }
  },
  "required": [
    "meta",
    "scenes"
  ],
  "title": "Reel scene spec",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reel.local/schema/scene_spec.schema.json",
  "description": "JSON scene spec v1.0: everything the offline renderer needs to produce a 45-60 s 1080x1920 reel. All times are scene-local seconds; positions are screen fractions."
}
