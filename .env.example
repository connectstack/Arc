# Optional: keys and defaults for the script -> JSON stage (`reel build --llm ...`).
# Copy this file to `.env` (it is git-ignored) and fill in what you use. A real shell variable always wins over this file.
# Nothing here is needed to render: `reel render` and the offline planner never touch the network.

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Default model for `reel build` when --llm is not given (provider:model, or just `openai` / `anthropic`):
# REEL_LLM=openai:gpt-4o-mini
# REEL_LLM=anthropic:claude-sonnet-5-5

# An OpenAI-compatible endpoint (a proxy, LM Studio, vLLM ...); `openai:model@URL` on the command line does the same:
# OPENAI_BASE_URL=http://localhost:1234/v1

# Optional: ElevenLabs for the voices (`reel build ... --tts elevenlabs`). Opt-in and billed by ElevenLabs; `--tts auto` never uses it.
# Spoken lines are cached on disk, so a line is paid for once. Never commit a real key.
# ELEVENLABS_API_KEY=
# REEL_TTS=elevenlabs                      # make it the default engine when --tts is not given
# ELEVENLABS_MODEL=eleven_multilingual_v2  # or eleven_v4, eleven_flash_v2_5 ...
# ELEVENLABS_VOICE=Rachel                  # one voice (name or id) for every speaker without a voice of their own
# ELEVENLABS_BASE_URL=https://api.eu.residency.elevenlabs.io   # another region (not read from a .env in the current directory)
